@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
@model Lap1.Models.Learner

<div class="ms-2 mx-2">
    <h1>Delete</h1>
    <h3 class="text-danger">Are you sure you want to delete this?</h3>
    <div>
        <h4>Learner Information</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Mã SV</dt>
            <dd class="col-sm-10">@Model.LearnerID</dd>

            <dt class="col-sm-2">Tên</dt>
            <dd class="col-sm-10">@Model.FirstMidName</dd>

            <dt class="col-sm-2">Họ</dt>
            <dd class="col-sm-10">@Model.LastName</dd>

            <dt class="col-sm-2">Chuyên ngành</dt>
            <dd class="col-sm-10">@Model.Major.MajorName</dd>

            <dt class="col-sm-2">Ngày nhập học</dt>
            <dd class="col-sm-10">@Model.EnrollmentDate.ToString("dd/MM/yyyy")</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="LearnerID" />
            <button type="submit" class="btn btn-danger">Delete</button> |
            <a asp-action="Index">Back to List</a>
        </form>
    </div>
</div>